# ==============================================================================
# CHAIR — Environment Configuration Template
# Copy to .env for local development. NEVER commit real secrets or .env files.
# ==============================================================================

# --- Runtime ---
APP_NAME=chair-api
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-64-char-random-hex-for-local-dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# --- PostgreSQL + PostGIS (Authoritative Booking Store) ---
# Docker Compose defaults shown below:
DATABASE_URL=postgresql+asyncpg://chair:chair_dev_password@localhost:5432/chair_db
TEST_DATABASE_URL=postgresql+asyncpg://chair:chair_dev_password@localhost:5432/chair_test_db

# --- Redis (Cache, Rate Limiting & Celery Broker) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Booking Engine Controls ---
BOOKING_HOLD_TTL_SECONDS=300
DEFAULT_SEARCH_RADIUS_METERS=5000
MAX_SEARCH_RADIUS_METERS=25000
ENABLE_DEMO_SEED=true

# --- Auth / Phone OTP Adapter ---
# Options: mock (dev/test only) | supabase | firebase | msg91
AUTH_OTP_PROVIDER=mock
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
FIREBASE_PROJECT_ID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Payments Adapter (India) ---
# Options: test_mode | razorpay
PAYMENT_PROVIDER=test_mode
PAYMENT_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- File Storage Adapter (Private KYC Docs & Style Passport Photos) ---
# Options: local_signed | s3 | supabase
STORAGE_PROVIDER=local_signed
LOCAL_STORAGE_DIR=.storage
STORAGE_SIGNING_SECRET=replace-with-local-signing-secret
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Maps & Geocoding Adapter ---
# Options: local_stub | google_maps | mapbox
MAPS_PROVIDER=local_stub
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Notifications Adapter ---
# Options: console_outbox | fcm_smtp
NOTIFICATION_PROVIDER=console_outbox
FCM_CREDENTIALS_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontends ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
